# ----------------------------------------------------------- Blockchain
# Sepolia testnet onerilir — bos birakilirsa API zincirsiz calisir.
# Kayit gerektirmeyen ucretsiz RPC: https://ethereum-sepolia-rpc.publicnode.com
# (alternatif: Alchemy / Infura ucretsiz anahtari)
RPC_URL=
# Sadece test cuzdani kullanin! Gercek varlik iceren anahtari ASLA koymayin.
PRIVATE_KEY=
# npm run deploy:contract ciktisindaki adres
CERT_ANCHOR_ADDRESS=
EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/

# ------------------------------------------------------ EVREN Yapay Zeka
# https://evren.ssyz.org.tr/api-keys — bos birakilirsa YZ kartlari kapali kalir.
EVREN_API_KEY=
# Istege bagli model / adres degisiklikleri:
# EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# EVREN_CHAT_MODEL=glm-5.3
# EVREN_OCR_MODEL=dots-ocr
# EVREN_DECISION_MODEL=clef
# EVREN_EMBED_MODEL=qwen3-embedding-8b
# EVREN_RERANK_MODEL=qwen3-reranker-8b

# ---------------------------------------------------------- Sunucu
# Render / Railway kendi PORT degiskenini verir.
PORT=3000
# Herkese acik demoda kotayi korumak icin IP basina dakikalik sinirlar
# AI_RATE_LIMIT_PER_MIN=20
